rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to validate path document IDs to prevent injection of trash/junk strings
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    // Helper for incoming document data
    function incoming() { 
      return request.resource.data; 
    }

    // Strict validator to protect against update-gaps, injection, and denial of wallet attacks
    function isValidMosque(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.address is string && data.address.size() > 0 && data.address.size() <= 200
        && data.latitude is number
        && data.longitude is number
        && data.fajr is string && data.fajr.size() > 0 && data.fajr.size() <= 10
        && data.zuhr is string && data.zuhr.size() > 0 && data.zuhr.size() <= 10
        && data.asr is string && data.asr.size() > 0 && data.asr.size() <= 10
        && data.maghrib is string && data.maghrib.size() > 0 && data.maghrib.size() <= 10
        && data.isha is string && data.isha.size() > 0 && data.isha.size() <= 10
        && data.jumah is string && data.jumah.size() > 0 && data.jumah.size() <= 10
        && data.imamUid is string && data.imamUid.size() > 0 && data.imamUid.size() <= 128
        && (!data.keys().contains('imamName') || (data.imamName is string && data.imamName.size() <= 100))
        && (!data.keys().contains('imamEmail') || (data.imamEmail is string && data.imamEmail.size() <= 100))
        && (!data.keys().contains('announcement') || (data.announcement is string && data.announcement.size() <= 500))
        && (!data.keys().contains('updatedAt') || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && (!data.keys().contains('eidFitr') || (data.eidFitr is string && data.eidFitr.size() <= 10))
        && (!data.keys().contains('eidAdha') || (data.eidAdha is string && data.eidAdha.size() <= 10))
        && (!data.keys().contains('sehri') || (data.sehri is string && data.sehri.size() <= 10))
        && (!data.keys().contains('iftar') || (data.iftar is string && data.iftar.size() <= 10));
    }

    match /mosques/{mosqueId} {
      allow read: if true;
      allow create, update: if isValidId(mosqueId) && isValidMosque(incoming());
      allow delete: if isValidId(mosqueId);
    }
  }
}
